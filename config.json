{
  "dbPath": "data/db/audit.db",
  "agents": {},
  "ingest": {
    "http": {
      "enabled": true,
      "maxBodyBytes": 1048576,
      "maxLineBytes": 65536
    },
    "spoolDir": "data/spool/incoming"
  },
  "capturesDir": "data/captures",
  "tmpDir": "data/tmp",
  "logDir": "logs",
  "limits": {
    "maxLineBytes": 65536,
    "maxChunkBytes": 16777216,
    "maxQueryLimit": 1000,
    "maxBodyBytes": 1048576
  },
  "report": {
    "timezoneOffsetMinutes": 480
  },
  "retention": {
    "enabled": true,
    "runAtHour": 4,
    "eventsHours": 48,
    "maxEventsPerAgent": 200,
    "runtimeRunsDays": 30,
    "waitingStatesDays": 30,
    "resolvedFindingsDays": 30,
    "reviewRunsDays": 60,
    "llmUsageDays": 90,
    "outboxDays": 14,
    "logFilesDays": 14,
    "tmpFilesDays": 7,
    "captureFilesDays": 30,
    "vacuum": "incremental"
  },
  "auditReview": {
    "enabled": true,
    "intervalMinutes": 30,
    "initialDelaySeconds": 30,
    "lookbackOverlapMinutes": 5,
    "maxEventsPerReview": 500,
    "notification": {
      "mode": "callback",
      "callbackUrl": "http://127.0.0.1:9999/audit-review-events",
      "minSeverity": "medium",
      "sendEmptyReview": false,
      "card": {
        "maxPayloadBytes": 19456,
        "foldThresholdChars": 800
      },
      "dailyReport": {
        "enabled": true,
        "hours": [10, 17],
        "timezoneOffsetMinutes": 480
      }
    },
    "http": {
      "bindHost": "127.0.0.1",
      "requireDashboardToken": false,
      "allowedOrigins": ["http://127.0.0.1:9320"]
    },
    "riskPolicy": {
      "version": "risk-policy-v1",
      "repeatWindowMinutes": 10,
      "repeatThreshold": 5,
      "slowCallDurationMs": 30000,
      "traceToolChainStepThreshold": 50,
      "highRiskToolPatterns": [
        "*delete*",
        "*write*",
        "*update*",
        "*deploy*",
        "*permission*",
        "*credential*",
        "shell.*",
        "browser.runScript"
      ],
      "agentToolAllowlists": {
        "rental-price-agent": [],
        "mt-agent": []
      }
    },
    "toolMapping": {
      "version": "tool-semantic-mapping-v1",
      "taxonomy": [
        "read",
        "write",
        "update",
        "delete",
        "deploy",
        "permission",
        "credential",
        "shell",
        "browser",
        "network",
        "database",
        "file",
        "notification",
        "llm",
        "unknown"
      ]
    },
    "llmReview": {
      "promptVersion": "audit-review-prompt-v1",
      "reviewerVersion": "audit-reviewer-v1"
    },
    "llmBudget": {
      "maxCallsPerDay": 500,
      "maxTokensPerDay": 2000000,
      "maxConcurrency": 2,
      "cacheDetailAnalysis": true
    },
    "visualization": {
      "enabled": true,
      "baseUrl": "http://127.0.0.1:9320",
      "dashboardPath": "/dashboard",
      "template": "audit-review-dashboard-v1",
      "attachDashboardUrlToFeishu": true
    }
  }
}
